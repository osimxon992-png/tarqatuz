# Copy to .env and fill in. .env is never committed.
ADMIN_USER=admin
ADMIN_PASSWORD=
PORT=8787

# Click merchant keys (from your Click merchant cabinet after signing the contract).
# Until they are set, the server refuses every Click request.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Where Click sends the advertiser after paying, e.g. https://tarqat.uz
PUBLIC_URL=

# Optional
# DB_PATH=server/data.db
# NODE_ENV=production   # adds the Secure flag to the login cookie (needs HTTPS)
