# Copy to .env and fill in. .env is never committed.
ADMIN_USER=admin
ADMIN_PASSWORD=
PORT=8787

# Click merchant keys (from your Click merchant cabinet after signing the contract).
# Until they are set, the server refuses every Click request.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Where Click sends the advertiser after paying, e.g. https://tarqat.uz
PUBLIC_URL=

# Telegram bot token from @BotFather. Without it the API runs with no bot.
BOT_TOKEN=
# Your Telegram id (send /id to the bot): new channels, orders and disputes are reported here.
ADMIN_CHAT_ID=
# Public HTTPS address of the Mini App page (.../tg/). Telegram refuses plain http and localhost.
WEBAPP_URL=

# Optional
# DB_PATH=server/data.db
# NODE_ENV=production   # adds the Secure flag to the login cookie (needs HTTPS)
